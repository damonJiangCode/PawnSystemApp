{
  "name": "@pawnsystem/database",
  "version": "1.0.0",
  "private": true,
  "description": "PostgreSQL schema, seed data and the Access-to-PostgreSQL migration.",
  "type": "module",
  "scripts": {
    "db:init": "node runInit.ts",
    "migration:prepare": "node migration/runner/prepareDevMigration.js",
    "migration:execute": "node migration/runner/executeDevMigration.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"migration/**/*.test.js\""
  },
  "dependencies": {
    "csv-parser": "^3.2.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@types/pg": "^8.23.1",
    "typescript": "^6.0.3"
  }
}
