{
  "name": "@pawnsystem/frontend",
  "version": "1.0.0",
  "private": true,
  "description": "React renderer for the pawn shop app, served and built with Vite.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --loader ts-node/esm --test \"src/**/*.test.ts\" \"src/**/*.test.js\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.8",
    "@mui/material": "^6.4.8",
    "@mui/x-data-grid": "^7.28.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.10"
  }
}
