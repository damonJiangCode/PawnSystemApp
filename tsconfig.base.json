{
  // Options every workspace shares. Each package's tsconfig.json extends this
  // and adds what is specific to it. The server is a separate project with its
  // own NestJS configuration.
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  }
}
