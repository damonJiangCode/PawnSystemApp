# Copy to .env, choose your own password, and use an isolated database.
DB_HOST=localhost
# Host port; Compose forwards this to PostgreSQL port 5432 in the container.
DB_PORT=5433
DB_NAME=pawnsystemdb
DB_USER=pawnsystem_dev
DB_PASSWORD=

# Renderer HTTP backend; set the store server address for LAN clients.
VITE_API_BASE_URL=http://localhost:3000

# Optional integration; use private credentials. Sandbox is the default.
LEADSONLINE_ENV=sandbox
LEADSONLINE_STORE_ID=
LEADSONLINE_USERNAME=
LEADSONLINE_PASSWORD=
