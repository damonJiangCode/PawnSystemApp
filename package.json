{
  "name": "pawnsystemsub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": ".electron-build/electron/src/main/index.js",
  "scripts": {
    "test": "node scripts/runTests.cjs",
    "migration:prepare": "node scripts/prepareDevMigration.cjs",
    "migration:execute": "node scripts/executeDevMigration.cjs",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "dev:server": "npm --prefix server run dev:server",
    "dev:main": "node scripts/prepareElectronBuild.cjs && tsc -p electron/tsconfig.json --watch --preserveWatchOutput",
    "dev:app": "wait-on http://localhost:5173 tcp:localhost:3000 file:.electron-build/package.json file:.electron-build/electron/src/main/index.js && node scripts/runElectron.cjs",
    "dev": "npm-run-all --print-label --parallel dev:frontend dev:server dev:main dev:app",
    "typecheck:main": "tsc --noEmit -p electron/tsconfig.json",
    "typecheck:renderer": "tsc --noEmit -p frontend/tsconfig.json",
    "build:main": "node scripts/prepareElectronBuild.cjs && tsc -p electron/tsconfig.json",
    "build": "npm run build:main && npm run typecheck:renderer && vite build --config frontend/vite.config.ts",
    "db:init": "npm run build:main && node .electron-build/database/runInit.js",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@types/pg": "^8.16.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "electron": "^41.1.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.10",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.8",
    "@mui/material": "^6.4.8",
    "@mui/x-data-grid": "^7.28.1",
    "csv-parser": "^3.2.0",
    "pg": "^8.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "soap": "^1.13.0"
  }
}
