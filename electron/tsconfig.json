{
  // Main process only. The preload is a hand-written CommonJS file (see
  // src/preload/README.md), so it is not compiled.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src/main",
    "outDir": "dist/main",
    "rewriteRelativeImportExtensions": true,
    "noEmitOnError": true,
    "types": ["node"]
  },
  "include": ["src/main"]
}
